<div class="pg pg-cover">
  <div class="cover-inner">
    <div class="cover-badge">📚 IPAS Kelas VI &nbsp;·&nbsp; Bab 6</div>
    <div class="solar-system">
      <div class="sun-core"></div>
      <div class="orbit orbit-1"><div class="planet mercury"></div></div>
      <div class="orbit orbit-2"><div class="planet earth"></div></div>
      <div class="orbit orbit-3"><div class="planet mars"></div></div>
    </div>

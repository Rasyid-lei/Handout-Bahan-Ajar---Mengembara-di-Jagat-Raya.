  <div class="page-bar bar-a"></div>
  <div class="pg-inner">

    <div class="sec-hdr">
      <div class="sec-letter la">A</div>
      <div class="sec-ttl"><span>Bagian Pertama</span><h2>Matahari, Bumi, dan Bulan</h2></div>

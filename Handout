<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mengembara di Jagat Raya – Handout IPAS Kelas VI</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── PRINT PAGE SETUP: no browser header/footer ── */
@page {
  size: A4;
  margin: 0;          /* kill ALL browser-added header/footer text */
}

/* ── VARIABLES ── */
:root {
  --ink:        #1a1c2e;
  --dim:        #5a6080;
  --card:       #f0f2fa;
  --border:     #dce0f0;
  --y:   #d48a00; --bg-y: #fffbea; --bd-y: #f0c040;
  --b:   #1a5fb5; --bg-b: #eaf3ff; --bd-b: #6aaae8;
  --pk:  #b5166b; --bg-pk:#fff0f6; --bd-pk:#e870a8;
  --g:   #1a8a4a; --bg-g: #eafff3; --bd-g: #48cc80;
  --pu:  #6a28b0;
  --or:  #c95b10;
  --tk:  #0e7a8a;
}

/* ── BODY ── */
body {
  background: #fff;
  color: var(--ink);
  font-family: 'Nunito', sans-serif;
  font-size: 10.5pt;
  line-height: 1.65;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

/* ── PAGE BLOCKS: each .pg is exactly one A4 page ── */
.pg {
  width: 210mm;
  height: 297mm;
  margin: 0 auto;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 8mm 13mm 8mm;
}

/* screen preview: show page shadow + gap */
@media screen {
  body { background: #c8cdd8; }
  .pg {
    box-shadow: 0 4px 24px rgba(0,0,0,0.22);
    margin: 10mm auto;
    background: #fff;
  }
}

/* ── PAGE BREAKS for print ── */
@media print {
  .pg { page-break-after: always; }
  .pg:last-child { page-break-after: avoid; }
  @keyframes spin { from{} to{} }   /* freeze animation for print */
}

/* ══════════════ COVER (page 1) ══════════════ */
.pg-cover {
  background: linear-gradient(160deg, #080c20 0%, #141b45 55%, #090e30 100%);
  padding: 0;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 0;
}
.pg-cover::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    radial-gradient(1.5px 1.5px at  8% 10%, rgba(255,255,255,.9), transparent),
    radial-gradient(1px   1px   at 22% 36%, rgba(255,255,255,.7), transparent),
    radial-gradient(2px   2px   at 38%  7%, rgba(255,255,255,.95),transparent),
    radial-gradient(1px   1px   at 52% 50%, rgba(255,255,255,.6), transparent),
    radial-gradient(1.5px 1.5px at 68% 17%, rgba(255,255,255,.85),transparent),
    radial-gradient(2px   2px   at 80% 60%, rgba(255,255,255,.9), transparent),
    radial-gradient(1px   1px   at 91% 30%, rgba(255,255,255,.75),transparent),
    radial-gradient(1px   1px   at 14% 70%, rgba(255,255,255,.8), transparent),
    radial-gradient(1.5px 1.5px at 33% 82%, rgba(255,255,255,.5),transparent),
    radial-gradient(1px   1px   at 58% 87%, rgba(255,255,255,.9), transparent),
    radial-gradient(2px   2px   at 75% 76%, rgba(255,255,255,.7), transparent),
    radial-gradient(1px   1px   at  4% 47%, rgba(255,255,255,.8), transparent),
    radial-gradient(1px   1px   at 46% 26%, rgba(255,255,255,.95),transparent),
    radial-gradient(1.5px 1.5px at 86%  7%, rgba(255,255,255,.8), transparent),
    radial-gradient(1px   1px   at 18% 92%, rgba(255,255,255,.4), transparent),
    radial-gradient(1px   1px   at 62%  5%, rgba(255,255,255,.7), transparent),
    radial-gradient(2px   2px   at 95% 50%, rgba(255,255,255,.6), transparent),
    radial-gradient(1px   1px   at 27% 57%, rgba(255,255,255,.5), transparent),
    radial-gradient(1px   1px   at  5% 88%, rgba(255,255,255,.7), transparent),
    radial-gradient(1.5px 1.5px at 50% 95%, rgba(255,255,255,.6), transparent),
    radial-gradient(1px   1px   at 73% 92%, rgba(255,255,255,.8), transparent);
  pointer-events: none; z-index: 0;
}
.cover-inner { position: relative; z-index: 1; width: 100%; padding: 0 12mm; }

/* solar orrery */
.solar-system {
  position: relative;
  width: 180px; height: 180px;
  margin: 0 auto 10mm;
}
.sun-core {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 50px; height: 50px;
  background: radial-gradient(circle, #fff9c4, #FFD700, #FF8C00);
  border-radius: 50%;
  box-shadow: 0 0 18px 9px rgba(255,180,0,.55), 0 0 36px 16px rgba(255,140,0,.28);
  animation: pulse-sun 3s ease-in-out infinite; z-index: 5;
}
@keyframes pulse-sun {
  0%,100% { box-shadow: 0 0 18px 9px rgba(255,180,0,.55),0 0 36px 16px rgba(255,140,0,.28); }
  50%      { box-shadow: 0 0 26px 14px rgba(255,180,0,.75),0 0 52px 24px rgba(255,140,0,.45); }
}
.orbit {
  position: absolute; top: 50%; left: 50%;
  border: 1px dashed rgba(255,255,255,.22); border-radius: 50%;
  transform: translate(-50%,-50%);
}
.orbit-1 { width:86px;  height:86px;  animation: spin  8s linear infinite; }
.orbit-2 { width:135px; height:135px; animation: spin 18s linear infinite; }
.orbit-3 { width:176px; height:176px; animation: spin 35s linear infinite; }
@keyframes spin {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to   { transform: translate(-50%,-50%) rotate(360deg); }
}
.planet { position: absolute; border-radius: 50%; }
.mercury { width:9px;  height:9px;  top:-4.5px; left:50%; margin-left:-4.5px;
  background: radial-gradient(circle at 35% 35%,#d8cfc4,#8c7b6e); }
.earth   { width:14px; height:14px; top:-7px;   left:50%; margin-left:-7px;
  background: radial-gradient(circle at 35% 35%,#64b5f6,#1565c0);
  box-shadow: 0 0 6px rgba(33,150,243,.8); }
.mars    { width:11px; height:11px; top:-5.5px; left:50%; margin-left:-5.5px;
  background: radial-gradient(circle at 35% 35%,#ef9a9a,#b71c1c); }

.cover-badge {
  display: inline-block;
  background: linear-gradient(135deg,#FF8C42,#FFD700);
  color: #1a0a00;
  font-family: 'Baloo 2',cursive; font-weight: 800; font-size: 8pt;
  letter-spacing: 2px; padding: 3px 14px; border-radius: 50px;
  text-transform: uppercase; margin-bottom: 5mm;
}
.cover h1 {
  font-family: 'Baloo 2',cursive; font-weight: 800; font-size: 32pt;
  line-height: 1.0; color: #FFD700;
  text-shadow: 0 2px 14px rgba(255,140,0,.5);
  margin-bottom: 4mm;
}
.cover-h1 { font-family:'Baloo 2',cursive; font-weight:800; font-size:32pt; line-height:1.0; color:#FFD700; text-shadow:0 2px 14px rgba(255,140,0,.5); margin-bottom:4mm; }
.cover-sub {
  font-size: 9pt; color: rgba(255,255,255,.55);
  letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 5mm;
}
.cover-pills {
  display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;
  margin-bottom: 6mm;
}
.pill {
  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
  border-radius: 50px; padding: 3px 12px; font-size: 8.5pt;
  color: rgba(255,255,255,.75);
}
.cover-greeting {
  background: rgba(255,255,255,.07); border: 1px solid rgba(0,229,255,.25);
  border-radius: 10px; padding: 5mm 8mm; text-align: left;
  max-width: 148mm; margin: 0 auto;
}
.cover-greeting h2 {
  font-family: 'Baloo 2',cursive; font-size: 11pt; font-weight: 700;
  color: #64d8f5; margin-bottom: 3mm;
}
.cover-greeting p { font-size: 9pt; color: rgba(255,255,255,.8); line-height: 1.6; }
.cover-greeting p + p { margin-top: 4px; }

/* ══════════════ CONTENT PAGES ══════════════ */

/* thin colour bar at top of each content page */
.page-bar {
  height: 5px; border-radius: 0 0 4px 4px;
  position: absolute; top: 0; left: 0; right: 0;
}
.bar-a { background: linear-gradient(90deg,#FFD700,#FF8C42); }
.bar-b { background: linear-gradient(90deg,#00b8d4,#1a5fb5); }
.bar-c { background: linear-gradient(90deg,#9c27b0,#e91e8c); }
.bar-d { background: linear-gradient(90deg,#1a8a4a,#00b8d4); }

/* page inner (push below bar) */
.pg-inner { padding-top: 5px; flex: 1; display: flex; flex-direction: column; gap: 2mm; overflow: hidden; }

/* ── SECTION HEADER ── */
.sec-hdr { display: flex; align-items: center; gap: 8px; }
.sec-letter {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Baloo 2',cursive; font-size: 16pt; font-weight: 800;
  border-radius: 9px; flex-shrink: 0;
}
.la { background: linear-gradient(135deg,#FFD700,#FF8C42); color: #1a0a00; }
.lb { background: linear-gradient(135deg,#00b8d4,#1a5fb5); color: #fff; }
.lc { background: linear-gradient(135deg,#9c27b0,#e91e8c); color: #fff; }
.sec-ttl h2 { font-family:'Baloo 2',cursive; font-size:13.5pt; font-weight:800; line-height:1.15; }
.sec-ttl span { font-size:7.5pt; text-transform:uppercase; letter-spacing:1.5px; color:var(--dim); }

/* ── CARD ── */
.card {
  background: var(--card); border-radius: 7px;
  padding: 3.5mm 5mm; border: 1px solid var(--border);
}
.card p { margin-bottom: 5px; font-size: 10pt; }
.card p:last-child { margin-bottom: 0; }

/* ── 2-COL LAYOUT ── */
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; }
.three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3mm; }
.four-col { display: grid; grid-template-columns: repeat(4,1fr); gap: 2.5mm; }

/* ── FACT BOX ── */
.fact {
  border-radius: 7px; padding: 3mm 4.5mm;
}
.fy  { background:var(--bg-y);  border:1px solid var(--bd-y);  border-left:4px solid var(--y); }
.fb  { background:var(--bg-b);  border:1px solid var(--bd-b);  border-left:4px solid var(--b); }
.fpk { background:var(--bg-pk); border:1px solid var(--bd-pk); border-left:4px solid var(--pk); }
.fg  { background:var(--bg-g);  border:1px solid var(--bd-g);  border-left:4px solid var(--g); }
.fact-tag {
  font-family:'Baloo 2',cursive; font-size:7.5pt; font-weight:700;
  text-transform:uppercase; letter-spacing:1px;
  padding:1px 8px; border-radius:50px; display:inline-block; margin-bottom:3px;
}
.fy  .fact-tag { background:var(--y);  color:#fff; }
.fb  .fact-tag { background:var(--b);  color:#fff; }
.fpk .fact-tag { background:var(--pk); color:#fff; }
.fg  .fact-tag { background:var(--g);  color:#fff; }
.fact-title { font-family:'Baloo 2',cursive; font-weight:700; font-size:10.5pt; margin-bottom:3px; }
.fy  .fact-title { color:var(--y); }
.fb  .fact-title { color:var(--b); }
.fpk .fact-title { color:var(--pk); }
.fg  .fact-title { color:var(--g); }
.fact p { font-size:9.5pt; margin-bottom:4px; }
.fact p:last-child { margin-bottom:0; }

/* ── DIVIDER LINE ── */
.divline {
  display:flex; align-items:center; gap:8px;
}
.divline::before,.divline::after {
  content:''; flex:1; height:1px;
  background:linear-gradient(90deg,transparent,var(--border),transparent);
}
.divline span { font-size:14pt; }

/* ── HIGHLIGHT ── */
.hl {
  border-left:3px solid var(--y); background:var(--bg-y);
  border-radius:0 6px 6px 0; padding:2.5mm 4mm;
  font-style:italic; font-size:9.5pt;
}

/* ── TIMEZONE STRIP ── */
.tz-strip {
  display:flex; border-radius:7px; overflow:hidden;
  border:1px solid var(--border);
}
.tz-bl { flex:1; padding:3mm 4mm; text-align:center; }
.tz-bl + .tz-bl { border-left:1px solid var(--border); }
.tz-bl.ty  { background:var(--bg-y); }
.tz-bl.tb  { background:var(--bg-b); }
.tz-bl.tpk { background:var(--bg-pk); }
.tz-name { font-family:'Baloo 2',cursive; font-size:12pt; font-weight:700; }
.ty  .tz-name { color:var(--y); }
.tb  .tz-name { color:var(--b); }
.tpk .tz-name { color:var(--pk); }
.tz-region { font-size:7.5pt; color:var(--dim); line-height:1.4; margin-top:2px; }
.tz-gmt { font-size:12pt; font-weight:700; margin-top:2px; }
.ty  .tz-gmt { color:var(--y); }
.tb  .tz-gmt { color:var(--b); }
.tpk .tz-gmt { color:var(--pk); }

/* ── SEASON TABLE ── */
.seas {
  display:grid; grid-template-columns:30mm 1fr 1fr;
  gap:1px; background:var(--border);
  border-radius:7px; overflow:hidden;
}
.sc { padding:2.5mm 3.5mm; background:#fff; font-size:9.5pt; }
.sc.hdr { background:var(--card); font-size:7.5pt; text-transform:uppercase;
  letter-spacing:1px; color:var(--dim); font-weight:700; }
.sc .mo { font-family:'Baloo 2',cursive; font-weight:700; font-size:10pt; color:var(--y); }

/* ── PLANET CARD ── */
.planet-card {
  border-radius:7px; padding:3mm; text-align:center;
  border:1px solid var(--border);
}
.planet-card .icon { height:35px; display:flex; justify-content:center; align-items:center; margin-bottom:4px; font-size:18pt; }
.planet-card .icon svg { height:100%; width:auto; }
.planet-card .pname { font-family:'Baloo 2',cursive; font-size:9pt; font-weight:700; margin:2px 0; }
.planet-card .pdesc { font-size:7.5pt; color:var(--dim); line-height:1.4; }
.pm { background:#f5f2ef; } .pm .pname { color:#5a4a3a; }
.pv { background:var(--bg-y); } .pv .pname { color:var(--y); }
.pb { background:var(--bg-b); } .pb .pname { color:var(--b); }
.pr { background:#fff0f0; } .pr .pname { color:#c0392b; }
.pj { background:#fff5ea; } .pj .pname { color:#b55a00; }
.ps { background:#fdfbea; } .ps .pname { color:#a07000; }
.pu2{ background:#eafcfc; } .pu2 .pname { color:#007a8a; }
.pn { background:var(--bg-b); } .pn .pname { color:var(--b); }

/* ── SAT CARD ── */
.sat-card {
  border-radius:7px; padding:3.5mm; text-align:center;
  border:1px solid var(--border);
}
.sat-card .icon { font-size:20pt; margin-bottom:3px; }
.sat-card .sname { font-family:'Baloo 2',cursive; font-size:10pt; font-weight:700; margin-bottom:3px; }
.sat-card .sdesc { font-size:8.5pt; color:var(--dim); }
.s1 { background:var(--bg-y); } .s1 .sname { color:var(--y); }
.s2 { background:var(--bg-b); } .s2 .sname { color:var(--b); }
.s3 { background:var(--bg-g); } .s3 .sname { color:var(--g); }

/* ── SUMMARY BOX ── */
.sumbox {
  background:var(--bg-y); border:1px solid var(--bd-y);
  border-left:4px solid var(--y); border-radius:7px;
  padding:4mm 5mm;
}
.sumbox h3 { font-family:'Baloo 2',cursive; font-size:12pt; font-weight:800; color:var(--y); margin-bottom:4mm; }
.sum-item { display:flex; gap:8px; align-items:flex-start; margin-bottom:4mm; font-size:9.5pt; }
.sum-item:last-child { margin-bottom:0; }
.sbullet {
  width:22px; height:22px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:9pt; font-weight:800; flex-shrink:0; margin-top:1px;
}
.by { background:var(--y);  color:#fff; }
.bb { background:var(--b);  color:#fff; }
.bpk{ background:var(--pk); color:#fff; }

/* ── QUESTION GRID ── */
.q-title { font-family:'Baloo 2',cursive; font-size:12pt; font-weight:800; color:var(--pu); margin-bottom:3mm; }
.q-grid { display:grid; grid-template-columns:1fr 1fr; gap:3mm; }
.q-card {
  background:var(--card); border-radius:7px;
  padding:4mm 4mm 3.5mm; border:1px solid var(--border);
  position:relative;
}
.q-num {
  position:absolute; top:-9px; left:10px;
  font-family:'Baloo 2',cursive; font-weight:800; font-size:7.5pt;
  padding:1px 9px; border-radius:50px;
}
.qn1{background:var(--y);  color:#fff;} .qn2{background:var(--tk); color:#fff;}
.qn3{background:var(--pk); color:#fff;} .qn4{background:var(--g);  color:#fff;}
.qn5{background:var(--pu); color:#fff;} .qn6{background:var(--or); color:#fff;}
.q-card p { font-size:9.5pt; margin-top:7px; line-height:1.5; }

/* ── UTILITY ── */
.kw   { color:var(--y);  font-weight:700; }
.kwb  { color:var(--b);  font-weight:700; }
.kwpk { color:var(--pk); font-weight:700; }
.kwg  { color:var(--g);  font-weight:700; }

svg { display:block; width:100%; }
</style>
</head>

  <rect width="680" height="240" rx="10" fill="#f0f4ff"/>
  <circle cx="30" cy="20" r="1.2" fill="#aaa"/><circle cx="80" cy="50" r="1" fill="#aaa"/>
  <circle cx="140" cy="15" r="1.5" fill="#aaa"/><circle cx="200" cy="45" r="1" fill="#aaa"/>
  <circle cx="320" cy="10" r="1.2" fill="#aaa"/><circle cx="440" cy="28" r="1" fill="#aaa"/>
